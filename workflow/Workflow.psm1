        )
    }
}
function Initialize-DEERRepository {
    param(
    [string]$Repository,
    [string]$CommitSha,
    [string]$Workspace,
    [string]$SubstDrive = "X:"
    )
    $RepoDirAbsolute = "$Workspace\repo"
    Write-Host "Cloning repository into $RepoDirAbsolute"
    New-Item -ItemType Directory -Force -Path $Workspace | Out-Null
    
    if (-not (Test-Path "$RepoDirAbsolute\.git")) {
        Write-Host "DEER prototypes/measure repository not found. Cloning..."
        
        # Validate that Repository is not empty and has a valid format
        if ([string]::IsNullOrWhiteSpace($Repository)) {
            throw "DEER prototypes/measure repository URL is not specified."
        }
        if ($Repository -notmatch "^[\w-]+/[\w-]+$") {
            throw "DEER repository URL is not in a valid format. Expected 'owner/repo'."
        }
        $Repository = $Repository.Trim()
        
        git clone "https://github.com/$Repository.git" $RepoDirAbsolute | Out-Host
        
        # If Git clone failed, throw an error
        if ($LASTEXITCODE -ne 0) {
            throw "Git clone failed for repository $Repository."
        }
    }
    else {
        Write-Host "DEER repository already exists. Reusing existing checkout."
    }
    git -C $RepoDirAbsolute remote get-url origin | Out-Host
    
    # In case the user re-runs the same job with a different commit, we need to fetch all commits to ensure the specified commit is available.
    git -C $RepoDirAbsolute fetch --all | Out-Host
    git -C $RepoDirAbsolute checkout $CommitSha | Out-Host
    
    # TODO: handle submodules if needed
    
    # Set last modified time for each file based on most recent change in git log.
    # Strategy: use open source python script "git-restore-mtime" directly from Github.

    # Fetch the tool from repo https://github.com/MestreLion/git-tools into Workspace.
    # TODO: Update to latest version if needed.
    # Use the v2025.08 release from the tag 'v2025.08'.
    if (-not (Test-Path "$Workspace\git-tools")) {
        Write-Host "Git-tools not found. Cloning git-tools..."
        git clone https://github.com/MestreLion/git-tools $Workspace\git-tools --branch v2025.08 | Out-Host
    } else {
        Write-Host "Git-tools already cloned."
    }
    
    # Run the script with attention to arguments:
    # --cwd or -C: Run as if started in given directory
    # --merge or -m: include merge commits.
    # pathspec: Only modify paths matching the given pattern.
    # TODO: pass the measure path into this function as pathspec (reduces processing time)
    
    $CondaExe = "C:\ProgramData\Anaconda3\Scripts\conda.exe"
    
    try {
        Write-Host "Running git-restore-mtime..."
        
        & $CondaExe run `
        -n py314 `
        python $Workspace\git-tools\git-restore-mtime --cwd $RepoDirAbsolute
    } catch {
        Write-Host "Failed to run git-restore-mtime."
    }

    # In Windows, long paths may require special handling. Prepare a virtual drive mapping to the repository folder.
    if ($IsWindows) {
        # Check if the drive is already assigned
        $driveAssigned = subst | Select-String -Pattern "^$SubstDrive"
        
        # subst.exe will fail if the drive is already assigned.
        # NativeCommandExitException: Program "subst.exe" ended with non-zero exit code: 1 (0x00000001)
        
        if ($driveAssigned) {
            # Unassign the drive if it is already assigned.
            subst $SubstDrive /D
        }
        # Assign the drive X: to the repository directory.
        subst $SubstDrive "$RepoDirAbsolute"
        $RepoDir = $SubstDrive
    } else {
        $RepoDir = $RepoDirAbsolute
    }
    
    return $RepoDir
    
}

function Invoke-WorkflowStep {
    # A reusable wrapper to invoke a step in the DEER simulation workflow with standardized outputs and effects.
    #
    # Responsibilities:
    # - Start timer
    # - Execute command
    # - Capture stdout/stderr
    # - Record exit code
    # - Record start/end timestamps
    # - Generate step-status.json
    # - Upload artifacts
    # - Fail fast
    #
    # Inputs:
    # [scriptblock]$Command
    #   Returns an object @( RunStatus, OutputFiles = @(...), Metrics = @(...) )
    #
    
    param(
    [string]$RunId,
    [int]$RunAttempt,
    [string]$S3Bucket,
    [string]$StepName,         # package-qc, compose, simulate
    [string]$WorkingDirectory, # working folder, e.g. "C:\githubactions\$RunId" 
    [string]$OutputDirectory,  # where artifacts go, e.g. "C:\githubactions\$RunId\attempt-$RunAttempt"
    [string]$ManifestPath, # path to the manifest file
    [scriptblock]$Command, # actual workload
    $RequiredInputs, # optional validation
    $RequiredOutputs # optional validation
    )
    
    $PSNativeCommandUseErrorActionPreference = $true
    $ErrorActionPreference = 'Stop'
    
    $LogFile = "$WorkingDirectory\transcript_$StepName.log"
    New-Item -ItemType Directory -Force -Path $WorkingDirectory | Out-Null
    New-Item -ItemType Directory -Force -Path $OutputDirectory | Out-Null
    
    # Capture everything written to the console
    Start-Transcript -Path $LogFile -Force
    
    $RunStatus = "Success"
    $FailureMessage = ""
    $StartDate = Get-Date
    $StepPath = "$WorkingDirectory\steps\$StepName"
    New-Item -ItemType Directory -Force -Path $StepPath | Out-Null
    
    try {
        
        # Validate the required inputs
        foreach ($file in $RequiredInputs) {
            if (-not (Test-Path $file)) {
                throw "Missing required input: $file"
            }
        }
        
        # Execute the script block
        $result = Invoke-Command -ScriptBlock $Command
        
        # Validate the output has the required members
        $requiredProperties = 'RunStatus', 'OutputFiles', 'Metrics'
        $actualProperties = $result | Get-Member -MemberType Properties | Select-Object -ExpandProperty Name
        $missingProperties = $requiredProperties | Where-Object { $_ -notin $actualProperties }
        
        # 4. Check results
        if ($null -eq $result) {
            Throw "Workflow return object validation Failed: The script block returned no output."
        }
        elseif ($missingProperties) {
            Throw "Workflow return object validation Failed: Output is missing required properties: $($missingProperties -join ', ')"
        }
        else {
            Write-Host "Workflow return object validation Passed: Output contains both OutputFiles and Metrics." -ForegroundColor Green
        }
        
        $RunStatus = $result.RunStatus
        $OutputFiles = $result.OutputFiles
        $Metrics = $result.Metrics
        
        # No validation required for RunStatus
        
        # Validate that output files exist
        foreach ($file in $RequiredOutputs) {
            $filePath = $file.Path
            if (-not (Test-Path "$OutputDirectory\$filePath")) {
                throw "Missing required output: $file"
            }
        }
        foreach ($file in $OutputFiles) {
            $filePath = $file.Path
            if (-not (Test-Path "$OutputDirectory\$filePath")) {
                throw "Missing output file: $file"
            }
        }
        
        # No validation required for Metrics
        
    }
    catch {
        
        Write-Host "ERROR:"
        Write-Host $_
        
        $RunStatus = "Failed"
        $FailureMessage = $_.Exception.Message
        Write-Host $_.Exception.StackTrace
        
    }
    finally {
        
        $EndDate = Get-Date
        
        
        $status = @{
            Step = $StepName
            Status = $RunStatus
            StartTime = $StartDate
            EndTime = $EndDate
            DurationSeconds = ($EndDate - $StartDate).TotalSeconds
            OutputFiles = $OutputFiles
            FailureMessage = $FailureMessage
            Metrics = $Metrics
        }
        
        # Write the status to a file
        $status |
        ConvertTo-Json |
        Set-Content "$StepPath\step-status.json"
        
        Stop-Transcript
        
        # Sync the log, status, and output files to S3
        & aws s3 cp `
        "$LogFile" `
        "s3://$S3Bucket/githubactions/$RunId/attempt-$RunAttempt/transcript_$StepName.log"
        & aws s3 cp `
        "$StepPath/step-status.json" `
        "s3://$S3Bucket/githubactions/$RunId/steps/$StepName/step-status.json"
        & aws s3 sync `
        "$OutputDirectory" `
        "s3://$S3Bucket/githubactions/$RunId/outputs/$StepName"
        
    }
    
    return [PSCustomObject]$status
}

function Update-Manifest {
    
    param(
    [string]$WorkingDirectory # working folder, e.g. "C:\githubactions\$RunId" 
    )
    
    # Reads all step-status files and updates the run-manifest.json.
    # Step status is new if its modified timestamp is newer than the run-manifest file modified timestamp.
    # Updating replaces the old value of the step element in the manifest, rather than creating a new step in the manifest.
    
    # Note that steps will be organized in the working directory like this:
    # steps/
    #   package-qc/
    #     step-status.json
    #   compose/
    #     step-status.json
    # Typical steps expected: 'package-qc', 'compose', 'simulate', 'collect', 'postprocess', 'custom-hooks'
    
    $manifestPath = "$WorkingDirectory/run-manifest.json"
    $timestampManifest = (Get-Item $manifestPath).LastWriteTime
    
    # Read and convert run-manifest JSON string into a PowerShell object
    $manifestObj = Get-Content -Path $manifestPath -Raw | ConvertFrom-Json
    
    # Get a list of step files (like stepName/step-status.json)
    $steps = Get-ChildItem "$WorkingDirectory/steps" -Recurse -Filter step-status.json
    
    foreach ($stepFile in $steps) {
        
        # Get the name of the step from the directory holding the step-status.json file. 
        $stepName = Split-Path $stepFile.DirectoryName -Leaf
        
        # Read and convert step-status JSON string into a PowerShell object
        $stepStatusObj = Get-Content $stepFile.FullName -Raw | ConvertFrom-Json
        
        if ($stepName -notin $manifestObj.steps.PSObject.Properties.Name) {
            throw "Unknown step '$stepName' (not found in run-manifest)"
        }
        
        #if ($stepFile.LastWriteTime -gt $timestampManifest)
        
        # Modify the specific property or element
        $manifestObj.steps.$stepName = $stepStatusObj
        
    }
    
    # Convert back to JSON and overwrite the file
    $manifestObj | ConvertTo-Json -Depth 100 | Set-Content -Path $manifestPath
    
}

function Invoke-DEERWorkflowController {
    param (
    [string]$WorkingDirectory, # working folder, e.g. "C:\githubactions\$RunId"
    [string]$RunId,
    [int]$RunAttempt,
    [string]$Repository,
    [string]$CommitSha,
    [string]$MeasurePath,
    [string]$S3Bucket,
    [System.Object]$RequestedSteps,
    [string]$WorkflowPackageS3Key,
    [string]$WorkflowCommitSha,
    [string]$ScenarioId
    )
    
    if ([string]::IsNullOrWhiteSpace($WorkingDirectory)) {
        $WorkingDirectory = "C:\githubactions\$RunId"
    }
    $manifestPath = "$WorkingDirectory\run-manifest.json"
    $S3RunPath = "s3://$S3Bucket/githubactions/$RunId"
    $S3SummaryPath = $S3RunPath
    $simulationSteps = @($RequestedSteps | Where-Object { $_ -match '^simulate-[1-9][0-9]*$' })
    if ($simulationSteps.Count -gt 0) {
        if (@($RequestedSteps).Count -ne 1 -or [string]::IsNullOrWhiteSpace($ScenarioId)) {
            throw 'A simulate-N request must specify exactly one step and a ScenarioId.'
        }
        $S3SummaryPath = "$S3RunPath/steps/$($simulationSteps[0])"
    }
    
    Write-Host "Preparing to clone prototypes repository ..."
    
    $RepoDir = Initialize-DEERRepository `
    -Repository $Repository `
    -CommitSha $CommitSha `
    -Workspace $WorkingDirectory
    
    $WorkflowSteps = @(
    'package-qc',
    'compose',
    'compose-qc',
    'simulate',
    'simulate-qc',
    'collect',
    'calculate'
    )
    $WorkflowSteps += $simulationSteps
    
    $StepHandlers = @{
        "package-qc" = {
            Invoke-PackageQc -ManifestPath $manifestPath -RepoDir $RepoDir `
            -MeasurePath $MeasurePath `
            -WorkingDirectory $WorkingDirectory `
            -OutputDirectory "$WorkingDirectory\outputs\package-qc"
        }
        
        "compose" = {
            Invoke-DEERCompose -ManifestPath $manifestPath -RepoDir $RepoDir `
            -MeasurePath $MeasurePath `
            -WorkingDirectory $WorkingDirectory `
            -OutputDirectory "$WorkingDirectory\outputs\compose" `
            -S3RunPath $S3RunPath
        }
        
        "compose-qc" = {
            Invoke-ComposeQc -ManifestPath $manifestPath -RepoDir $RepoDir `
            -MeasurePath $MeasurePath `
            -WorkingDirectory $WorkingDirectory `
            -OutputDirectory "$WorkingDirectory\outputs\compose-qc"
        }
        
        "simulate" = {
            Invoke-DEERSimulate -ManifestPath $manifestPath -RepoDir $RepoDir `
            -MeasurePath $MeasurePath `
            -WorkingDirectory $WorkingDirectory `
            -OutputDirectory $OutputDirectory `
            -S3RunPath $S3RunPath `
            -ScenarioId $ScenarioId `
            -StepName $step
        }
        
        "simulate-qc" = {
            Invoke-DEERSimulateQc -ManifestPath $manifestPath -RepoDir $RepoDir `
            -MeasurePath $MeasurePath `
            -WorkingDirectory $WorkingDirectory `
            -OutputDirectory "$WorkingDirectory\outputs\simulate-qc"
        }
        
        "collect" = {
            Invoke-DEERCollect -ManifestPath $manifestPath -RepoDir $RepoDir `
            -MeasurePath $MeasurePath `
            -WorkingDirectory $WorkingDirectory `
            -OutputDirectory "$WorkingDirectory\outputs\collect"
        }
        
        "calculate" = {
            Invoke-DEERCalculate -ManifestPath $manifestPath -RepoDir $RepoDir `
            -MeasurePath $MeasurePath `
            -WorkingDirectory $WorkingDirectory `
            -OutputDirectory "$WorkingDirectory\outputs\calculate"
        }
        
    }
    
    If (-not (Test-Path $manifestPath)) {
        Invoke-GenerateManifest `
        -RunId $RunId `
        -RunAttempt $RunAttempt `
        -Repository $Repository `
        -CommitSha $CommitSha `
        -MeasurePath $MeasurePath `
        -PlannedSteps $WorkflowSteps `
        -WorkflowPackageS3Key $WorkflowPackageS3Key `
        -WorkflowCommitSha $WorkflowCommitSha `
        -ManifestPath $manifestPath
    }
    # Update requested steps in the manifest to match the current request
    $manifestObj = Get-Content -Path $manifestPath -Raw | ConvertFrom-Json
    $manifestObj.workflow.plannedSteps = @($WorkflowSteps)
    foreach ($simulationStep in $simulationSteps) {
        if ($simulationStep -notin $manifestObj.steps.PSObject.Properties.Name) {
            $manifestObj.steps | Add-Member -NotePropertyName $simulationStep -NotePropertyValue $null
        }
    }
    
    # The workflow package is frozen when the run starts; re-run attempts must use the same package.
    $frozenPackage = $manifestObj.workflow.PSObject.Properties['package']
    if ($frozenPackage -and $frozenPackage.Value.s3Key) {
        if ($WorkflowPackageS3Key -and $frozenPackage.Value.s3Key -ne $WorkflowPackageS3Key) {
            throw "Workflow package mismatch: run is frozen to '$($frozenPackage.Value.s3Key)' but '$WorkflowPackageS3Key' was requested."
        }
    }
    else {
        $manifestObj.workflow | Add-Member -NotePropertyName package -Force -NotePropertyValue ([PSCustomObject]@{
            s3Key = $WorkflowPackageS3Key
            commitSha = $WorkflowCommitSha
        })
    }
    $manifestObj | ConvertTo-Json -Depth 100 | Set-Content -Path $manifestPath
    
    # Initialize summary.md with a header row
    $summaryPath = "$WorkingDirectory\summary.md"
    $summaryContent = @"
| Step | Status | Start Time | End Time | Duration (s) | Metrics |
| --- | --- | --- | --- | --- | --- |
"@
    
    foreach ($step in $RequestedSteps) {
        $handlerName = if ($step -match '^simulate-[1-9][0-9]*$') { 'simulate' } else { $step }
        # Validate StepName is a valid workflow step
        $validSteps = $StepHandlers.Keys
        if ($handlerName -notin $validSteps) {
            throw "Invalid step name: $step"
        }
        $OutputDirectory = "$WorkingDirectory\outputs\$step"
        
        Invoke-WorkflowStep `
        -RunId $RunId `
        -RunAttempt $RunAttempt `
        -S3Bucket $S3Bucket `
        -StepName $step `
        -WorkingDirectory $WorkingDirectory `
        -OutputDirectory $OutputDirectory `
        -ManifestPath $manifestPath `
        -Command $StepHandlers[$handlerName]
        
        Update-Manifest -WorkingDirectory $WorkingDirectory
        
        # TODO: update summary.md
        # Read steps/stepName/step-status.json and update summary.md with a table of step names, status, start/end times, duration, and metrics.
        $stepStatus = Get-Content "$WorkingDirectory\steps\$step\step-status.json" -Raw | ConvertFrom-Json
        $summaryContent += "| $($stepStatus.Step) | $($stepStatus.Status) | \
    $($stepStatus.StartTime) | $($stepStatus.EndTime) | \
    $([math]::Round($stepStatus.DurationSeconds, 2)) | \
    $($stepStatus.Metrics | ConvertTo-Json -Compress) |\n"
        
        # TODO: aggregate telemetry
        
    }
    # WRite the summary content to summary.md
    $summaryContent | Set-Content -Path $summaryPath
    
    # Sync summary.md to S3
    aws s3 cp `
    "$summaryPath" `
    "$S3SummaryPath/summary.md"
    
    # Sync run-manifest.json to S3
    aws s3 cp `
    "$manifestPath" `
    "$S3SummaryPath/run-manifest.json"
}

function Invoke-GenerateManifest {
    param(
    $manifestPath,
    $RunId,
    $RunAttempt,
    $Repository,
    $CommitSha,
    $MeasurePath,
    $PlannedSteps,
    $WorkflowPackageS3Key,
    $WorkflowCommitSha
    )
    
    $manifestDirectory = Split-Path -Path $manifestPath -Parent
    if ($manifestDirectory -and -not (Test-Path -Path $manifestDirectory)) {
        New-Item -ItemType Directory -Path $manifestDirectory -Force | Out-Null
    }
    
    
    # Initialize dictionary with each step name as a key
    $StepsObject = [ordered]@{}
    foreach ($StepName in $PlannedSteps) {
        $StepsObject[$StepName] = $null 
    }
    
    # Create an object representing the manifest
    
    $manifest = [PSCustomObject]@{
        schemaVersion = "1.0"
        run = [PSCustomObject]@{
            runId = $RunId
            runAttempt = [int]$RunAttempt
            createdUtc = (Get-Date).ToString("o")
            requestedBy = $null
        }
        source = [PSCustomObject]@{
            repository = $Repository
            branch = $null
            commitSha = $CommitSha
        }
        measure = [PSCustomObject]@{
            measurePath = $MeasurePath
            measureId = $null
            measureType = "residential"
        }
        workflow = [PSCustomObject]@{
            workflowVersion = "1.0"
            composeOnly = $false
            plannedSteps = @($PlannedSteps)
            package = [PSCustomObject]@{
                s3Key = $WorkflowPackageS3Key
                commitSha = $WorkflowCommitSha
            }
        }
        compute = [PSCustomObject]@{
            profile = "test"
            instanceType = $null
        }
        artifacts = [PSCustomObject]@{
            s3Bucket = ""
            s3Prefix = $null
        }
        steps = [PSCustomObject]$StepsObject
    }
    
    # Write the manifest object into a JSON file.
    $manifest | ConvertTo-Json -Depth 100 | Set-Content -Path $manifestPath
}

function Invoke-PackageQc {
    param(
    [string]$RepoDir,
    [string]$MeasurePath,
    [string]$WorkingDirectory,
    [string]$OutputDirectory,
    [string]$ManifestPath
    )
    
    $CondaExe = "C:\ProgramData\Anaconda3\Scripts\conda.exe"
    
    & $CondaExe run `
    -n py314 `
    python `
    "$PSScriptRoot\MeasureQc.py" `
    "$RepoDir\$MeasurePath" `
    "$OutputDirectory"
    
    $measureQcData = Get-Content "$OutputDirectory\measure-qc.json" -Raw | ConvertFrom-Json
    $measureRoot = "$RepoDir\$MeasurePath"
    $measureBytes =
    (
    Get-ChildItem $measureRoot -Recurse -File |
    Measure-Object -Property Length -Sum
    ).Sum
    # Return status = Success if "status": "Passed", else "Failed"
    if ($measureQcData.status -eq "Passed") {
        $runStatus = "Success"
    } else {
        $runStatus = "Failed"
    }
    
    return [PSCustomObject]@{
        RunStatus = $runStatus
        OutputFiles = [PSCustomObject]@(
        [PSCustomObject]@{
            Path  = "measure-qc.json"
            Bytes = (get-item "$OutputDirectory\measure-qc.json").length
        }
        [PSCustomObject]@{
            Path  = "scenario-index.json"
            Bytes = (get-item "$OutputDirectory\scenario-index.json").length
        }
        [PSCustomObject]@{
            Path  = "measure-qc.md"
            Bytes = (get-item "$OutputDirectory\measure-qc.md").length
        }
        )
        Metrics = [PSCustomObject]@{
            scenarioCount = $measureQcData.inventory.scenarioCount
            measureBytes  = $measureBytes
            countClimates = $measureQcData.inventory.countClimates
            countCohorts  = $measureQcData.inventory.countCohorts
        }
    }
}

function Invoke-DEERCompose {
    param(
    [string]$RepoDir,
    [string]$MeasurePath,
    [string]$WorkingDirectory,
    [string]$OutputDirectory,
    [string]$ManifestPath,
    [string]$S3RunPath
    )
    
    $scenarioIndexPath =
    "$WorkingDirectory\outputs\package-qc\scenario-index.json"
    
    if (-not (Test-Path $scenarioIndexPath)) {
        throw "Scenario index not found: $scenarioIndexPath"
    }
    
    $scenarios = Get-Content $scenarioIndexPath -Raw | ConvertFrom-Json
    
    $outputFiles = @()
    
    $composeSuccesses = 0
    $composeFailures = 0
    $composeOutputBytes = 0
    
    foreach ($scenario in $scenarios) {
        
        $scenarioId = $scenario.scenarioId
        $scenarioOutputDir = Join-Path $OutputDirectory $scenarioId
        New-Item -ItemType Directory -Force -Path $scenarioOutputDir | Out-Null
        
        $stepStatusPath = Join-Path $scenarioOutputDir "step-status.json"
        
        $composeLog = Join-Path $scenarioOutputDir "compose.log"
        
        $scenarioRoot = Join-Path (Join-Path $RepoDir $MeasurePath) $scenarioId
        
        $ComposeOutputRoot = Join-Path $scenarioOutputDir "runs"
        $MeasureRunsDir = Join-Path $scenarioRoot "runs"
        
        $scenarioStatus = @{
            Step = "compose"
            ScenarioId = $scenarioId
            Status = "Running"
            StartTime = Get-Date
        }
        
        try {
            
            Push-Location $scenarioRoot
            
            & modelkit rake compose *> $composeLog
            
            Pop-Location
            
            $scenarioStatus.Status = "Succeeded"
            
            $composeSuccesses++
            
        }
        catch {
            
            Pop-Location -ErrorAction SilentlyContinue
            
            $scenarioStatus.Status = "Failed"
            $scenarioStatus.FailureMessage = $_.Exception.Message
            
            $composeFailures++
            
            # Sprint 1 default behavior:
            # stop on first failure
            
            $scenarioStatus | ConvertTo-Json | Set-Content $stepStatusPath
            
            throw
            
        }
        finally {
            
            $scenarioStatus.EndTime = Get-Date
            
            $scenarioStatus.DurationSeconds =
            ($scenarioStatus.EndTime - $scenarioStatus.StartTime).TotalSeconds
            
            $scenarioStatus | ConvertTo-Json -Depth 20 |
            Set-Content $stepStatusPath
        }
        
        $composeOutputBytes += (Get-ChildItem "$MeasureRunsDir" -Recurse -File | Measure-Object Length -Sum).Sum
        $logBytes = (Get-Item $composeLog).Length
        $composeOutputBytes += $logBytes
        # Archive the runs folder to S3
        & aws s3 cp "$MeasureRunsDir" "$S3RunPath/compose/$scenarioId/runs" --recursive
        
        $outputFiles += @(
        [PSCustomObject]@{
            Path = "$scenarioId\compose.log"
            Bytes = $logBytes
        }
        )
    }
    
    return [PSCustomObject]@{
        
        RunStatus = "Success"
        
        OutputFiles = $outputFiles
        
        Metrics = @{
            ScenarioCount      = $scenarios.Count
            ComposeSuccesses   = $composeSuccesses
            ComposeFailures    = $composeFailures
            ComposeOutputBytes = $composeOutputBytes
        }
    }
}

