{
    "RoleName": "${GITHUB_SIMULATION_ROLE_NAME}",
    "PolicyName": "${GITHUB_SIMULATION_ROLE_POLICY_NAME}",
    "PolicyDocument": {
        "Version": "2012-10-17",
        "Statement": [
            {
                "Sid": "Statement1forEC2",
                "Effect": "Allow",
                "Action": [
                    "ec2:StartInstances",
                    "ec2:DescribeInstances",
                    "ec2:RunInstances",
                    "ec2:CreateTags",
                    "ec2:DescribeLaunchTemplates",
                    "ec2:DescribeLaunchTemplateVersions",
                    "ec2:DescribeInstanceStatus",
                    "ssm:DescribeInstanceInformation"
                ],
                "Resource": "*"
            },
            {
                "Sid": "StopAndTerminate",
                "Effect": "Allow",
                "Action": [
                    "ec2:StopInstances",
                    "ec2:TerminateInstances"
                ],
                "Resource": "*",
                "Condition": {
                    "StringEquals": {
                        "ec2:ResourceTag/ManagedBy": "GitHubActions",
                        "ec2:ResourceTag/Workload": "RunDeerSimulations"
                    }
                }
            },
            {
                "Sid": "PassRole",
                "Effect": "Allow",
                "Action": "iam:PassRole",
                "Resource": "arn:aws:iam::${AWS_ACCOUNT_ID}:role/${EC2_INSTANCE_ROLE_NAME}",
                "Condition": {
                    "StringEquals": {
                        "iam:PassedToService": "ec2.amazonaws.com"
                    }
                }
            },
            {
                "Sid": "Statement2forSSM",
                "Effect": "Allow",
                "Action": [
                    "ssm:SendCommand",
                    "ssm:GetCommandInvocation",
                    "ssm:ListCommands",
                    "ssm:ListCommandInvocations"
                ],
                "Resource": "*",
                "Condition": {
                    "StringEquals": {
                        "ec2:ResourceTag/ManagedBy": "GitHubActions",
                        "ec2:ResourceTag/Workload": "RunDeerSimulations"
                    }
                }
            },
            {
                "Sid": "Statement3forS3Bucket",
                "Effect": "Allow",
                "Action": [
                    "s3:ListBucket"
                ],
                "Resource": "arn:aws:s3:::${SIMULATION_BUCKET}"
            },
            {
                "Sid": "Statement4forS3Object",
                "Effect": "Allow",
                "Action": [
                    "s3:GetObject",
                    "s3:PutObject"
                ],
                "Resource": [
                    "arn:aws:s3:::${SIMULATION_BUCKET}/githubactions/*"
                ]
            }
        ]
    }
}
