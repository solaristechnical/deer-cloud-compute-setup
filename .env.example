# AWS
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=replace-with-aws-account-id
AWS_DEPLOY_ROLE_ARN=replace-with-deploy-role-arn
AWS_SIMULATION_ROLE_ARN=replace-with-simulation-role-arn
GITHUB_SIMULATION_ROLE_NAME=replace-with-simulation-role-name
GITHUB_SIMULATION_ROLE_POLICY_NAME=replace-with-simulation-role-policy-name
EC2_INSTANCE_ROLE_NAME=replace-with-instance-role-name
SECURITY_GROUP_ID=replace-with-security-group-id
EC2_INSTANCE_PROFILE_ARN=replace-with-instance-profile-arn
EC2_KEY_PAIR_NAME=replace-with-key-pair-name
EC2_SUBNET_ID=replace-with-subnet-id
SIMULATION_INSTANCE_ID=replace-with-instance-id

# DEER workflow
SIMULATION_BUCKET=replace-with-bucket-name
DEPLOY_BUCKET=replace-with-deploy-bucket-name
EC2_LAUNCH_TEMPLATE_ID=replace-with-launch-template-id
EC2_LAUNCH_TEMPLATE_VERSION=latest

# Instance sizing profiles
EC2_INSTANCE_TYPE_TEST=c8in.xlarge
EC2_INSTANCE_TYPE_STANDARD=c8in.8xlarge
EC2_INSTANCE_TYPE_LARGE=c8in.32xlarge

# Runtime inputs
REPOSITORY=owner/repository
COMMIT_SHA=<git-commit-sha>
MEASURE_PATH=commercial measures/example
RUN_PROFILE=test
RUN_ID=local-test
RUN_ATTEMPT=1

# Workflow stages
REQUESTED_STEPS=package-qc,compose

# Optional
CLOUDWATCH_LOG_GROUP=/aws/ssm/githubactions
